{
  "name": "speakami-web",
  "description": "A Next.js template with TypeScript, Tailwind CSS, and React Hook Form.",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "md-clone": "rm -rf content/blog-md && cd content && git clone ${BLOG_MD_REPO_URL:-https://git.unipus.cn/liujunhua/blog-md.git} && cd ..",
    "dev": "NEXT_PUBLIC_DEBUG=true cross-env APP_ENV=local next dev",
    "dev:test": "pnpm md-clone && velite build && cross-env APP_ENV=test next dev",
    "dev:production": "pnpm md-clone && velite build && cross-env APP_ENV=production next dev",
    "build": "pnpm md-clone && velite build && cross-env APP_ENV=production next build",
    "build:dev": "pnpm md-clone && velite build && cross-env APP_ENV=development next build && storybook build --docs -o public/storybook-static && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "build:test": "pnpm md-clone && velite build && cross-env APP_ENV=test next build && storybook build --docs -o public/storybook-static && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "build:production": "pnpm md-clone && velite build && cross-env APP_ENV=production next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "start:build": "PORT=80 node .next/standalone/server.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix .",
    "api:generate": "node scripts/generate-api.mjs",
    "api:generate:watch": "nodemon --watch scripts/generate-api.mjs --exec 'pnpm api:generate'",
    "commit": "git-cz",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --docs -o public/storybook-static",
    "registry:build": "shadcn build",
    "registry:start": "shadcn build && http-server ./public -p 2025"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@shopify/storefront-api-client": "^1.0.10",
    "@tencentcloud/chat": "^3.6.1",
    "@unipus/speakami-web-sdk": "0.1.5",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "immer": "^11.1.0",
    "lodash-es": "^4.17.22",
    "lucide-react": "^0.561.0",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "next-template": "link:",
    "next-themes": "^0.4.6",
    "rc-virtual-list": "^3.19.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.69.0",
    "react-intersection-observer": "^10.0.0",
    "rtl-detect": "^1.1.2",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@next/bundle-analyzer": "^16.2.2",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/nextjs": "^10.1.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/rtl-detect": "^1.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rehype-slug": "^6.0.0",
    "storybook": "^10.1.10",
    "swagger-typescript-api": "^13.2.16",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "velite": "^0.3.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint"
    ],
    "*.{scss,less,css}": [
      "prettier"
    ],
    "*.{json,md}": [
      "prettier"
    ]
  }
}
