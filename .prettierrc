{
  "arrowParens": "always",
  "endOfLine": "lf",
  "jsonRecursiveSort": true,
  "plugins": ["prettier-plugin-sort-json", "prettier-plugin-tailwindcss"],
  "printWidth": 100,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "tailwindFunctions": ["tv", "cn", "cva"],
  "tailwindStylesheet": "./styles/globals.css",
  "trailingComma": "all",
  "useTabs": false
}
